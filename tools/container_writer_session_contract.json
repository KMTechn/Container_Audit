        "replacement_transaction_id": "33333333333333333333333333333333",
        "writer_contract_sha256": "4444444444444444444444444444444444444444444444444444444444444444",
        "expected_mutex_name": "Local\\KMTech.ContainerAudit.DeploymentSession.1121406d92315036b04c14edfea1a09a03938923fa052324623e225d006a7b0c"
      },
      {
        "session_id": "0123456789abcdef0123456789abcdef",
        "attempt_id": "fedcba9876543210fedcba9876543210",
        "orchestrator_sha256": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
        "replacement_transaction_id": "00112233445566778899aabbccddeeff",
        "writer_contract_sha256": "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100",
        "expected_mutex_name": "Local\\KMTech.ContainerAudit.DeploymentSession.7487aff53f2ea39a278e3648037625e8c1484636d80a5177dee05ba06556f071"
      }
