    "admission_mutex_name": "Local\\KMTech.ContainerAudit.WriterAdmission.v1",
    "noncanonical_mutex_derivation": "Local\\KMTech.ContainerAudit.WriterAdmission.v1.<first 16 lowercase hex characters of SHA-256 over the absolute control root after slash-to-backslash conversion, trailing-backslash removal, Unicode NFC, and ASCII A-Z to a-z mapping with every other code point unchanged, encoded as UTF-8 without BOM>",
    "session_mutex_prefix": "Local\\KMTech.ContainerAudit.DeploymentSession.",
    "session_tuple_version": "container-audit-deployment-session-authority-v1",
    "session_tuple_fields": [
      "session_tuple_version",
      "session_id",
      "attempt_id",
      "orchestrator_sha256",
      "replacement_transaction_id",
      "writer_contract_sha256"
    ],
    "tuple_separator": "LF (U+000A) between ordered fields; no trailing LF",
    "tuple_encoding": "UTF-8 without BOM",
    "tuple_normalization": "Unicode NFC applied to each field before joining",
    "writer_inventory_path": "tools/container_writer_sink_inventory.json",
    "writer_inventory_sha256": "b41fce75d4ae6742b553dd47c7bd2cc66cd13353cd182ecfe50ef93652114383",
    "canonical_installer_delegation_source": "writer_sink_sources from the exact pinned code-derived inventory",
    "scheduled_task_mutation_rule": "Every Disable/Enable/Stop/Start/Register/Unregister/Set cmdlet executes only inside an approved container writer wrapper while the admission mutex is held; the exact active fence, live session authority, and immutable prepared-receipt path plus SHA-256 are validated before and after the mutation.",
    "natural_trigger_phase_rule": "After exact enable readback, an immutable authorization receipt releases the fence under admission; a failed natural-trigger proof must reacquire the fence before any safety or containment mutation.",
    "verification_vectors": [
      {
