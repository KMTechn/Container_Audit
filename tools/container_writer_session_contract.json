{
  "schema": "container-audit-writer-session-cli-contract-v1",
  "app_id": "container_audit",
  "cli": {
    "relative_path": "tools/container_writer_session.ps1",
    "public_writer_modes": [
      "Contract",
      "Prepare",
      "ValidatePrepared",
      "RestoreWriter"
    ],
    "compatibility_modes": [
      "ValidateReplacement",
      "Recover"
    ],
